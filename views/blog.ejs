<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog Post</title>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="container mt-4">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <img src="<%= blog.uploadFile %>" class="card-img-top" alt="Blog Image">
                    <div class="card-body">
                        <h2 class="card-title text-primary"><%= blog.title %></h2>
                        <p class="text-muted">Written by:</p>
                        <hr>
                        <pre class="fs-5 text-wrap" style="white-space: pre-wrap;"><%= blog.content %></pre>
                    </div>
                </div>
                
                <div class="mt-4">
                    <h3 class="mb-3">Comments</h3>
                    <form action="/comment" method="post" class="mb-3">
                        <input type="hidden" name="blogId" value="<%= blog._id %>">
                        <div class="input-group">
                            <input type="text" name="content" class="form-control" placeholder="Write a comment..." required>
                            <button type="submit" class="btn btn-primary">Comment</button>
                        </div>
                    </form>
                    
                    <% if (locals.Comments && Comments.length > 0) { %>
                        <div class="list-group">
                            <% Comments.forEach(comment => { %>
                                <div class="list-group-item d-flex align-items-start">
                                    <img src="<%= comment.uploadfile %>" class="rounded-circle me-2" alt="User" width="40" height="40">
                                    <div>
                                        <h6 class="mb-1"><%= comment.commentedBy.username %></h6>
                                        <p class="mb-1 text-muted"><%= comment.content %></p>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <p class="text-muted">No comments yet. Be the first to comment!</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
    <%- include('partials/script') %>
</body>
</html>
