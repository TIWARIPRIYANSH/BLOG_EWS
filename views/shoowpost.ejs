<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <%- include('partials/head') %>

    <style>
        /* Ensuring all images in the cards are uniform */
        .card-img-top {
            width: 100%; /* Makes image fill card width */
            height: 200px; /* Set a fixed height */
            object-fit: cover; /* Ensures images fill the space without distortion */
        }

        /* Ensuring all cards have the same height */
        .card {
            height: 100%;
        }

        .card-body {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="container mt-4">
        <div class="row g-4"> 
            <% for(let index = 0; index < locals.posts.length; index++) { %>
                <div class="col-lg-4 col-md-6 col-sm-12"> 
                    <div class="card" style="width: 100%;"> 
                        <img src="<%= locals.posts[index].uploadFile %>" class="card-img-top" alt="Post Image">
                        <div class="card-body">
                            <h5 class="card-title"><%= locals.posts[index].title %></h5>
                            <p class="card-text"><%= locals.posts[index].content %></p>
                            <a href="/viewpost/<%=locals.posts[index]._id %>" class="btn btn-primary">Click</a>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <%- include('partials/script') %>
</body>
</html>
